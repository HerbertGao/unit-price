{
  "name": "@unit-price/miniapp",
  "version": "0.0.0",
  "private": true,
  "description": "只读榜单微信小程序（消费 GET /rankings）",
  "scripts": {
    "build:weapp": "node scripts/check-react-compat.mjs && node scripts/vendor-api-client.mjs && taro build --type weapp",
    "dev:weapp": "node scripts/check-react-compat.mjs && node scripts/vendor-api-client.mjs && taro build --type weapp --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @unit-price/api-client build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.13",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "@unit-price/api-client": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.24.0",
    "@tarojs/cli": "4.3.2",
    "esbuild": "^0.28.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/react": "18.3.31",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "4.3.2",
    "react-refresh": "^0.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
